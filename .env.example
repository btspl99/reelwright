# Copy to .env. Every value is optional; defaults work for a single-user trial.
REELWRIGHT_PUBLIC_URL=https://clips.example.com
REELWRIGHT_REGISTRATION_OPEN=true
# Transcription: faster-whisper (local), openai (API), sidecar
REELWRIGHT_TRANSCRIPTION_PROVIDER=faster-whisper
REELWRIGHT_WHISPER_MODEL=small
# Optional LLM ranking (any OpenAI-compatible endpoint)
REELWRIGHT_LLM_BASE_URL=
REELWRIGHT_LLM_API_KEY=
REELWRIGHT_LLM_MODEL=
# Postgres (compose profile "postgres"); leave empty for SQLite
POSTGRES_PASSWORD=change-me
